{
  "name": "inbox-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Inbox assistant for a small painting business: classify mail, extract invoices, verify totals in code, draft replies, human approval before anything leaves. Plus a quote vs order form reconciliation mode.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,blue \"tsx watch src/server/main.ts\" \"vite\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "node --import tsx src/server/main.ts",
    "seed": "tsx scripts/seed.ts",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "eval": "tsx scripts/eval.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "screenshots": "tsx scripts/screenshots.ts",
    "smtp-sink": "tsx scripts/smtp-sink.ts",
    "n8n": "tsx scripts/n8n.ts",
    "send-test-mail": "tsx scripts/send-test-mail.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "html-to-text": "^10.0.1",
    "mailparser": "^3.15.0",
    "nodemailer": "^10.6.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.7",
    "lucide-react": "^1.79.0",
    "motion": "^14.14.0",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.1",
    "smtp-server": "^3.21.7",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
