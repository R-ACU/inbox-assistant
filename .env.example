# Copy to .env and fill in. Never commit .env.
# Generate the two secrets with:  npm run hash-password -- "<your password>"

# Login for the approval UI (scrypt hash, not the password itself)
APP_PASSWORD_HASH=
# Shared secret for signed requests between n8n and the assistant (min. 32 characters)
INBOX_WEBHOOK_SECRET=

# mock = fixed answers from fixtures/ (no API calls, no cost). claude = real Claude API.
LLM_MODE=mock
# Only needed for LLM_MODE=claude. Read from this file only, never from the global environment.
ANTHROPIC_API_KEY=
# MODEL_CLASSIFY=claude-haiku-5-5
# MODEL_TEXT=claude-sonnet-5-5

PORT=3220
HOST=127.0.0.1
# Origins allowed to send state-changing requests (CSRF check). Add your HTTPS origin in production.
APP_ORIGINS=http://127.0.0.1:3220,http://localhost:3220,http://127.0.0.1:3221,http://localhost:3221
# Set to true behind HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
DATA_DIR=./data

# Only when n8n drives the flow. Resume URLs from n8n must start with this origin.
N8N_BASE_URL=http://127.0.0.1:5690
# Token a mail relay must send to the n8n intake webhook (stored in n8n as a credential by npm run n8n -- setup)
N8N_INGRESS_TOKEN=
# n8n data folder (default ./.n8n, ignored by git). Point it elsewhere if the system drive is full.
N8N_USER_FOLDER=./.n8n
# Only for local scripts (n8n demo, screenshots): the plain login password. Leave empty elsewhere.
DEMO_PASSWORD=
